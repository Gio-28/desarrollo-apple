# --- Sesion / seguridad ---
# Genera una cadena aleatoria larga, ej: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# URL publica del sitio, sin barra final (en local: http://localhost:8000)
BASE_URL=http://localhost:8000

# --- Base de datos (usuarios, 2FA) ---
# En Vercel esto lo inyecta automaticamente la integracion de base de datos (Neon/Postgres).
# En local, pega la cadena de conexion de tu base de datos de desarrollo.
DATABASE_URL=

# --- Administrador inicial (se crea automaticamente la primera vez que arranca la app, solo si la tabla de usuarios esta vacia) ---
ADMIN_USERNAME=admin
# Genera una clave fuerte, ej: python -c "import secrets; print(secrets.token_urlsafe(16))"
ADMIN_PASSWORD=

# --- Dropbox Sign (antes HelloSign) para el envio a firma ---
DROPBOX_SIGN_API_KEY=

# --- Correo para enviar los codigos de verificacion (2FA) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Contraseña de aplicacion de esa cuenta (no la contraseña normal)
SMTP_PASSWORD=
# Opcional: si se deja vacio, se usa SMTP_USER como remitente
SMTP_FROM=
