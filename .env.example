# --- Sesion / seguridad ---
# Genera una cadena aleatoria larga, ej: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Acceso restringido a la empresa ---
ALLOWED_EMAIL_DOMAIN=appletravel.com.co

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL publica del sitio, sin barra final (en local: http://localhost:8000)
BASE_URL=http://localhost:8000

# --- Anthropic (para leer el "bloc de notas" y extraer los datos del contrato) ---
ANTHROPIC_API_KEY=

# --- Dropbox Sign (antes HelloSign) para el envio a firma ---
DROPBOX_SIGN_API_KEY=
